{
  "manifest_version": 3,
  "name": "Arbeitszeit",
  "version": "1.2.0",
  "description": "Private, lokale Erfassung der heutigen Arbeitszeit mit dynamischen Pausen.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Arbeitszeit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}